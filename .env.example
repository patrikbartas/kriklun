# Supabase. Bez tychto premennych bezi appka lokalne do .data/reports.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fotky

# Pin pre operatorsky rezim na /operator. Bez neho je operator zavrety.
OPERATOR_PIN=

# Zakladna adresa pre odkazy v mailoch
SITE_URL=https://kriklun.com

# SMTP. Bez tychto premennych sa maily ticho preskocia.
# Port 465 = implicitne TLS, 587 = STARTTLS. Port 25 byva blokovany.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Kam chodi upozornenie na nove hlasenie
NOTIFY_EMAIL=
